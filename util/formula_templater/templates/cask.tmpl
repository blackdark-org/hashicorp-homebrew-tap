require_relative "../lib/hashicorp_mirror"

cask "hashicorp-{{ .Product }}" do
  version "{{ .Version }}"

  on_macos do
  {{- if and .Architectures.DarwinAmd64SHA .Architectures.DarwinArm64SHA }}
    arch arm: "arm64", intel: "amd64"

    sha256 arm:   "{{ .Architectures.DarwinArm64SHA }}",
           intel: "{{ .Architectures.DarwinAmd64SHA }}"

    url "#{HashicorpMirror.url}/{{ .Product }}/#{version}/{{ .Product }}_#{version}_darwin_#{arch}.dmg"
  {{- else }}
  {{- if .Architectures.DarwinAmd64SHA }}
    sha256 "{{ .Architectures.DarwinAmd64SHA }}"

    url "#{HashicorpMirror.url}/{{ .Product }}/#{version}/{{ .Product }}_#{version}_darwin_amd64.dmg"
  {{- end }}
  {{- if .Architectures.DarwinArm64SHA }}
    sha256 "{{ .Architectures.DarwinArm64SHA }}"

    url "#{HashicorpMirror.url}/{{ .Product }}/#{version}/{{ .Product }}_#{version}_darwin_arm64.dmg"
  {{- end }}
  {{- end }}

  {{- if .CaskApp }}

    app "{{ .CaskApp }}"
  {{- else }}

    pkg "{{ .CaskPkg }}"
  {{- end }}

  {{- if eq .Product "vagrant" }}

    uninstall script:  {
                executable: "uninstall.tool",
                input:      ["Yes"],
                sudo:       true,
              },
              pkgutil: "com.{{ .Product}}.{{ .Product }}"

    zap trash: "~/.{{ .Product }}.d"
  {{- end}}
  end

  name "{{ .Name }}"
  desc "{{ .Desc }}"
  homepage "{{ .Homepage }}"

  depends_on :macos
end
